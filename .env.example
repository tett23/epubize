# send-to-kindle の設定（ADR 0028）。send to Kindle のときに send-to-kindle に --env-file で渡す。
#
# このファイルを .env という名前で次の場所に写し、値を書き込む。管理画面で別の場所を指定してもよい。
#   ~/Library/Application Support/com.github.tett23.epubize/<環境>/.env
# このファイル自体も同じ場所に .env.example として置くと、.env に足りないキーを管理画面に出す。
# .env にはパスワードを書くため、コミットしない（.gitignore で除いている）。

# 送信元のメールアドレス。Amazon の「承認済み E メールアドレス一覧」に加えておく
EMAIL=

# Kindle のメールアドレス（Amazon の「コンテンツと端末の管理」の端末の欄にある @kindle.com のアドレス）
SEND_TO_KINDLE_EMAIL=

# 送信に使う SMTP サーバー。Gmail なら smtp.gmail.com、587、Google アカウントのアプリ パスワード
SMTP_HOST=
SMTP_PORT=
SMTP_USER_NAME=
SMTP_PASSWORD=
